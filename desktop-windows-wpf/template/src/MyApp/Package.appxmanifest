<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX（Store / サイドロード）レーン。Release-Store 構成でのみ使う。Publisher は証明書と一致させる -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">
  <Identity Name="com.example.MyApp" Publisher="CN=EXAMPLE" Version="0.1.0.0" />
  <Properties>
    <DisplayName>MyApp</DisplayName>
    <PublisherDisplayName>Example</PublisherDisplayName>
    <Logo>Resources\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources><Resource Language="x-generate" /></Resources>
  <Applications>
    <Application Id="App" Executable="MyApp.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="MyApp" Description="MyApp" BackgroundColor="transparent"
                          Square150x150Logo="Resources\Square150x150Logo.png" Square44x44Logo="Resources\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
