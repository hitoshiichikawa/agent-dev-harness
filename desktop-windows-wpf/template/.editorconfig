root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml,props,targets,csproj,sln,xaml}]
indent_size = 2

[*.cs]
# スタイル（dotnet format が適用）
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:error
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:error
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_readonly_field = true:error
dotnet_diagnostic.IDE0005.severity = error   # 未使用 using
dotnet_diagnostic.IDE0051.severity = error   # 未使用 private メンバー
dotnet_diagnostic.IDE0060.severity = error   # 未使用パラメータ

# 命名
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Analyzer（latest-all を基準に、業務アプリで過剰なものを落とす）
dotnet_diagnostic.CA1014.severity = none     # CLSCompliant
dotnet_diagnostic.CA1062.severity = none     # 引数 null 検証（Nullable で代替）
dotnet_diagnostic.CA1303.severity = none     # リテラル文字列のローカライズ
dotnet_diagnostic.CA1848.severity = none     # LoggerMessage デリゲート
dotnet_diagnostic.CA2007.severity = none     # ConfigureAwait（WPF では UI スレッドに戻りたい）
dotnet_diagnostic.CA1031.severity = error    # 広すぎる catch は禁止
dotnet_diagnostic.CA2008.severity = error    # TaskScheduler 未指定
dotnet_diagnostic.VSTHRD100.severity = error # async void

[*.xaml.cs]
# コードビハインドは InitializeComponent のみ（lint では縛れない。CLAUDE.md とフックで）
