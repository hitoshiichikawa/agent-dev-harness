{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(make:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet tool restore:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(dotnet ef migrations script:*)",
      "Bash(dotnet --info:*)",
      "Bash(dotnet --version:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git checkout -b:*)", "Bash(git switch:*)", "Bash(git stash:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Bash(dotnet publish:*)",
      "Bash(dotnet ef database:*)",
      "Bash(dotnet ef migrations remove:*)",
      "Bash(vpk:*)",
      "Bash(MakeAppx:*)",
      "Bash(makeappx:*)",
      "Bash(SignTool:*)",
      "Bash(signtool:*)",
      "Bash(msstore:*)",
      "Bash(sudo:*)",
      "Read(**/*.pfx)", "Read(**/*.p12)", "Read(**/*.snk)", "Read(.env)", "Read(.env.*)",
      "Read(**/appsettings.Production.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "EXTRA_DENY=$(cat .claude/hooks/extra-deny.txt 2>/dev/null) bash .claude/hooks/common/guard-bash.sh" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "bash .claude/hooks/guard-edit-wpf.sh && bash .claude/hooks/common/guard-edit.sh" } ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "bash .claude/hooks/post-edit.sh" } ]
      }
    ]
  }
}
