{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep",
      "Bash(make:*)",
      "Bash(flutter pub:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter run:*)",
      "Bash(flutter devices:*)",
      "Bash(flutter doctor:*)",
      "Bash(flutter screenshot:*)",
      "Bash(flutter clean:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart run build_runner:*)",
      "Bash(dart fix:*)",
      "Bash(xcrun simctl:*)",
      "Bash(adb shell screencap:*)",
      "Bash(adb devices:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git checkout -b:*)", "Bash(git switch:*)", "Bash(git stash:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Bash(flutter build:*)",
      "Bash(fastlane:*)",
      "Bash(bundle exec fastlane:*)",
      "Bash(xcodebuild -exportArchive:*)",
      "Bash(codesign:*)",
      "Bash(sudo:*)",
      "Read(.env)", "Read(.env.*)",
      "Read(**/*.keystore)", "Read(**/*.jks)", "Read(**/*.p12)", "Read(**/*.mobileprovision)",
      "Read(**/key.properties)", "Read(**/GoogleService-Info.plist)", "Read(**/google-services.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "EXTRA_DENY=$(cat .claude/hooks/extra-deny.txt 2>/dev/null) bash .claude/hooks/common/guard-bash.sh" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "bash .claude/hooks/common/guard-edit.sh" } ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "bash .claude/hooks/post-edit.sh" } ]
      }
    ]
  }
}
